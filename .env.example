# Para que serve: variáveis de ambiente da app fictícia Acme API (template).
# Função: documentar env de app e integrações — copiar para .env local (gitignored).
# Example environment variables (no real secrets)
# Copy to .env locally — never commit .env

# App
NODE_ENV=development
LOG_LEVEL=debug
DATABASE_URL=postgresql://acme:acme@localhost:5432/acme_dev

# MCP / integrations (see .cursor/mcp.env.example)
GITHUB_PERSONAL_ACCESS_TOKEN=ghp_REPLACE_WITH_YOUR_TOKEN
LINEAR_API_KEY=lin_api_REPLACE_WITH_YOUR_KEY
